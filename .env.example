# 选择使用的 LLM: "siliconflow" 或 "deepseek"
LLM_PROVIDER=siliconflow

# SiliconFlow (硅基流动) — 注册地址: https://siliconflow.cn
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# DeepSeek — 注册地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat
